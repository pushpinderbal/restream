# Optional server and upstream request controls (defaults shown).
# Library, Trending and playback options live in app Settings.
# LISTEN_ADDR=:8080
# SESSION_TTL=45s
# STALKER_USER_AGENT=
# STALKER_MAX_RESPONSE_MB=64
# STALKER_REQUEST_TIMEOUT=1m
# STALKER_REQUEST_INTERVAL=250ms

# Optional provider overrides. Omit these to manage the fields in app Settings.
# Every supplied field is managed by environment and read-only in the app.
# Keep this file private. Do not uncomment an empty field unless intentional.
# STALKER_PORTAL_URL=http://your-provider.example
# STALKER_MAC=00:11:22:33:44:55
# STALKER_TIMEZONE=UTC
# STALKER_SERIAL_NUMBER=
# STALKER_DEVICE_ID=
# STALKER_DEVICE_ID2=
