# No environment variables are required by default. Configure the provider in Settings.
# Copy to .env and uncomment only what you need; keep secrets private.

# Provider: portal URL and MAC are required to watch, set here or in Settings.
# Env values override saved settings and lock those fields in the UI, even if empty.
# Serial number and device IDs are needed only if your provider requires them.
# STALKER_PORTAL_URL=http://your-provider.example
# STALKER_MAC=00:11:22:33:44:55
# STALKER_TIMEZONE=UTC
# STALKER_SERIAL_NUMBER=
# STALKER_DEVICE_ID=
# STALKER_DEVICE_ID2=

# Server/request defaults. SESSION_TTL is the playback heartbeat timeout.
# LISTEN_ADDR=:8080
# SESSION_TTL=45s
# STALKER_USER_AGENT=
# STALKER_MAX_RESPONSE_MB=64
# STALKER_REQUEST_TIMEOUT=1m
# STALKER_REQUEST_INTERVAL=250ms

# Optional OIDC; default AUTH_TYPE=none allows anonymous admin access.
# Required for OIDC: APP_URL, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET,
# and either OIDC_ISSUER_URL or OIDC_DISCOVERY_URL.
# Confidential client: PKCE S256, refresh tokens, scopes openid profile.
# Callback: <APP_URL>/auth/callback. Claim restream_role must be viewer or admin
# in ID tokens and UserInfo. HTTPS required except for loopback development.
# AUTH_TYPE=oidc
# APP_URL=https://restream.example.com
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
