# Portal credentials. Keep your .env private.
STALKER_PORTAL_URL=
STALKER_MAC=
STALKER_TIMEZONE=UTC
MAX_STREAMS=1

# Optional portal device identity; set values registered with your provider.
# STALKER_SERIAL_NUMBER=
# STALKER_DEVICE_ID=
# STALKER_DEVICE_ID2=
# STALKER_USER_AGENT=

# Optional upstream limits (defaults shown).
# STALKER_MAX_RESPONSE_MB=64
# STALKER_REQUEST_TIMEOUT=1m
# STALKER_REQUEST_INTERVAL=250ms
# STALKER_EPG_HOURS=6

# Server refresh cadence. Change environment values and restart to apply.
# Catalogue and discovery follow this cadence. Guide and episode freshness
# adapt automatically; provider cooldowns and request pacing remain separate.
# REFRESH_INTERVAL=6h
# Older CATALOG_REFRESH_INTERVAL remains a fallback when this is unset.

# Comma-separated exact category names or IDs (case-insensitive).
# Empty Dashboard list includes all categories. Blocked categories are hidden
# and cannot be played. Optional prefixes: live:, movie:, series:.
# DASHBOARD_CATEGORIES=live:News,movie:Drama,series:Drama
# BLOCKED_CATEGORIES=Adult

# Optional TMDB discovery. Use your own read access token or API key.
# Only trending titles confirmed in your portal are displayed.
# TMDB_API_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
